#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Data directory, owned by the service account. The config installed at
    # /etc/cameodb/cameodb.toml points data_paths here.
    install -d -o cameodb -g cameodb -m 700 /var/lib/cameodb

    # Key digests for [[security.api_keys]] key_hash_file. Owned by root and only readable by
    # the service, so the node cannot rewrite its own key ring. Created only when missing, so
    # an operator's own ownership survives an upgrade.
    [ -d /etc/cameodb/keys ] || install -d -o root -g cameodb -m 750 /etc/cameodb/keys

    # For [logging] directory and [security.audit] file, both off in the shipped config. The
    # node writes here as the service user.
    [ -d /var/log/cameodb ] || install -d -o cameodb -g cameodb -m 750 /var/log/cameodb

    # The config is a conffile (dpkg keeps local edits across upgrades). It holds no secret
    # by default, but may once keys are added, so it is readable by the service group only.
    if [ -f /etc/cameodb/cameodb.toml ]; then
        chown root:cameodb /etc/cameodb/cameodb.toml
        chmod 640 /etc/cameodb/cameodb.toml
    fi

    # No systemd (a container, a chroot): the files are in place, nothing to start.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable cameodb.service

        if [ -z "$2" ]; then
            # Fresh install
            systemctl start cameodb.service
        elif systemctl is-active --quiet cameodb.service; then
            # Upgrade of a running node
            systemctl restart cameodb.service
        fi
    fi
fi

exit 0
