*.tmp
*.temp

# Scripts are committed but their logs/outputs are ignored
!/scripts/
scripts/**/*.log
scripts/**/*.tmp

# Environment and configuration
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Runtime and cache directories
.cache/
.rustup/

# .cargo/config.toml is build configuration, not a cache: it carries the musl link and
# hardening flags and jemalloc's page size. Ignoring the whole directory meant a fresh clone
# silently built release binaries with none of them. Credentials stay ignored.
#
# `.cargo/*` rather than `.cargo/` on purpose — git does not descend into an excluded
# directory, so a negation cannot re-include a file underneath one.
.cargo/*
!.cargo/config.toml

# Backup files
*.orig
*.rej

# Profiling and debugging
*.prof
perf.data*
flamegraph.svg

# Documentation build artifacts
# Generated documentation should not be committed:
# - target/doc/ (rustdoc output) - already covered by /target/
# - book/ (mdbook output)
# - docs/book/ (if using mdbook in docs/)
# - docs/web/ (Next.js website build artifacts and node_modules)
# 
# Source documentation SHOULD be committed:
# - docs/*.md (our architecture and API docs)
# - README.md files
# - Inline /// documentation in source code
book/
docs/book/
docs/web/
docs/webpage

# Local development overrides
local.toml
dev.toml
cameodb.toml
cameodb.yaml
